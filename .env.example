# ==========================================
# Marketing Intelligence - Environment Setup
# ==========================================
# Copy this file to .env and replace the values 
# with your actual API keys. DO NOT commit your 
# actual .env file to version control.

# Groq API Key for LLM Inference (Required)
# Get your free key at: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# (Optional) Override the default Groq model
GROQ_MODEL="llama-3.1-8b-instant"

# (Optional) Pipeline Hard Limits
MAX_ARTICLES="20"
MAX_AGENT_ITERATIONS="5"
